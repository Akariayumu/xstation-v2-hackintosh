+void S0ixStandby::publishAcEcWake()
+{
+	if (!acNoEcWake) {
+		setProperty("AC EC wake block", "off (boot-arg -s0ixacnoecwake)");
+		return;
+	}
+	char names[64];
+	names[0] = 0;
+	size_t pos = 0;
+	uint32_t count = 0;
+	bool appliedValid = false;
+	bool appliedEnable = true;
+	if (acWakeLock) IOLockLock(acWakeLock);
+	count = ecWakeDevCount;
+	appliedValid = ecWakeAppliedValid;
+	appliedEnable = ecWakeAppliedEnable;
+	for (uint32_t i = 0; i < ecWakeDevCount; i++) {
+		const char *nm = (ecWakeDevs[i] && ecWakeDevs[i]->getName()) ? ecWakeDevs[i]->getName() : "?";
+		if (pos < sizeof(names)) {
+			int n = snprintf(names + pos, sizeof(names) - pos, "%s%s", i ? ", " : "", nm);
+			if (n > 0) pos += (size_t)n;
+		}
+	}
+	if (acWakeLock) IOLockUnlock(acWakeLock);
+
+	char buf[160];
+	if (ecGpe == 0xFFFFFFFF) {
+		snprintf(buf, sizeof(buf), "pending: waiting for EC _GPE");
+	} else if (!count) {
+		snprintf(buf, sizeof(buf), "pending: waiting for ACPI wake device with acpi-wake-s0-gpe == 0x%x", ecGpe);
+	} else if (!psSeen || !appliedValid) {
+		snprintf(buf, sizeof(buf), "pending: waiting for IOPMPowerSource (%s, GPE 0x%x)", names, ecGpe);
+	} else {
+		snprintf(buf, sizeof(buf), "%s: %s (GPE 0x%x) wake %s",
+		         onAC ? "on AC" : "on battery", names, ecGpe,
+		         appliedEnable ? "enabled" : "disabled");
+	}
+	setProperty("AC EC wake block", buf);
+	setProperty("On AC (last check)", onAC);
+}
+
+void S0ixStandby::syncAcWakePolicy(bool updateRegistry)
+{
+	bool prevSeen = psSeen;
+	bool prevAC = onAC;
+	if (updateRegistry) {
+		updateAC();
+		if (acNoEcWake && ecWakeDevCount == 0) {
+			bool hadEcGpe = (ecGpe != 0xFFFFFFFF);
+			findEcWakeDevices();
+			if (!hadEcGpe && ecGpe != 0xFFFFFFFF)
+				publishEcWake();
+		}
+	}
+	if (!acNoEcWake)
+		return;
+
+	bool changed = false;
+	if (psSeen) {
+		bool wantEnable = !onAC;
+		if (acWakeLock) IOLockLock(acWakeLock);
+		if (ecWakeDevCount > 0 && (!ecWakeAppliedValid || ecWakeAppliedEnable != wantEnable || !updateRegistry)) {
+			changed = (!ecWakeAppliedValid || ecWakeAppliedEnable != wantEnable);
+			for (uint32_t i = 0; i < ecWakeDevCount; i++) {
+				if (ecWakeDevs[i])
+					ecWakeDevs[i]->setSystemWakeCapabilityEnable(wantEnable);
+			}
+			ecWakeAppliedEnable = wantEnable;
+			ecWakeAppliedValid = true;
+		}
+		if (acWakeLock) IOLockUnlock(acWakeLock);
+	}
+
+	if (updateRegistry) {
+		publishAcEcWake();
+		if (psSeen && (!prevSeen || prevAC != onAC || changed))
+			battCheck();
+		if (changed) {
+			if (OSString *s = OSDynamicCast(OSString, getProperty("AC EC wake block")))
+				LOG("AC EC wake block: %s", s->getCStringNoCopy());
+			publishLog();
+		}
+	}
+}
