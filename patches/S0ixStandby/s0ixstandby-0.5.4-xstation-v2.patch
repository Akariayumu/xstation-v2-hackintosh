+void S0ixStandby::findEcWakeDevices()
+{
+	if (ecGpe == 0xFFFFFFFF)
+		findEcGpe();
+	if (ecGpe == 0xFFFFFFFF)
+		return;
+	const IORegistryPlane *plane = IORegistryEntry::getPlane("IOACPIPlane");
+	if (!plane)
+		return;
+	IORegistryIterator *it = IORegistryIterator::iterateOver(plane, kIORegistryIterateRecursively);
+	if (!it)
+		return;
+	while (IORegistryEntry *e = it->getNextObject()) {
+		IOACPIPlatformDevice *dev = OSDynamicCast(IOACPIPlatformDevice, e);
+		if (!dev)
+			continue;
+		OSNumber *s0Gpe = OSDynamicCast(OSNumber, dev->getProperty("acpi-wake-s0-gpe"));
+		if (!s0Gpe || s0Gpe->unsigned32BitValue() != ecGpe)
+			continue;
+		if (acWakeLock) IOLockLock(acWakeLock);
+		bool exists = false;
+		for (uint32_t i = 0; i < ecWakeDevCount; i++) {
+			if (ecWakeDevs[i] == dev) {
+				exists = true;
+				break;
+			}
+		}
+		if (!exists && ecWakeDevCount < kMaxEcWakeDevs) {
+			dev->retain();
+			ecWakeDevs[ecWakeDevCount++] = dev;
+			ecWakeAppliedValid = false;
+		}
+		if (acWakeLock) IOLockUnlock(acWakeLock);
+	}
+	it->release();
+}
