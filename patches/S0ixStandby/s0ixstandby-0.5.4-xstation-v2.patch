+bool S0ixStandby::powerSourcePublished(void *target, void *, IOService *newService, IONotifier *)
+{
+	S0ixStandby *self = OSDynamicCast(S0ixStandby, static_cast<OSObject *>(target));
+	if (!self || !newService)
+		return true;
+	if (self->acWakeLock) IOLockLock(self->acWakeLock);
+	if (!self->psInterestNotifier) {
+		self->psInterestNotifier = newService->registerInterest(
+		    gIOGeneralInterest, &S0ixStandby::powerSourceInterest, self, nullptr);
+	}
+	if (self->acWakeLock) IOLockUnlock(self->acWakeLock);
+	if (self->acTimer)
+		self->acTimer->setTimeoutMS(1);
+	return true;
+}
+
+IOReturn S0ixStandby::powerSourceInterest(void *target, void *, UInt32, IOService *, void *, vm_size_t)
+{
+	S0ixStandby *self = OSDynamicCast(S0ixStandby, static_cast<OSObject *>(target));
+	if (self && self->acTimer)
+		self->acTimer->setTimeoutMS(1);
+	return kIOReturnSuccess;
 }
 
