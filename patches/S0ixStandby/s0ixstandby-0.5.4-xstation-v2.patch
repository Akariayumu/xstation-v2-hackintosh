+// --- On-demand Gen12 GPU frequency export (read-only, zero-forcewake) --------
+// Triggered from user space via IORegistryEntrySetCFProperties({"refreshGpuFreq": true}).
+// Never writes PCI config space or MMIO forcewake registers.
+
+IOReturn S0ixStandby::refreshGpuFreq()
+{
+	if (!gpuFreqLock)
+		return kIOReturnUnsupported;
+	IOLockLock(gpuFreqLock);
+	if (isInactive() || !gpuMMIO || !gpuDev || !dispTgl) {
+		IOLockUnlock(gpuFreqLock);
+		return kIOReturnUnsupported;
+	}
+	uint32_t actualMHz = 0;
+	uint32_t reqMHz = 0;
+	if (!gpuSleeping) {
+		uint16_t pmcsr = gpuPmCap ? gpuDev->configRead16(gpuPmCap + kPmcsrOff) : 0;
+		uint16_t cmd = gpuDev->configRead16(kIOPCIConfigCommand);
+		if ((pmcsr & 3) == 0 && (cmd & kIOPCICommandMemorySpace) != 0) {
+			uint32_t ack = gpuRead(kFwRenderAck);
+			if (ack != 0xFFFFFFFF && (ack & 0xFFFF) != 0) {
+				uint32_t rpstat1 = gpuRead(kGen12Rpstat1);
+				if (rpstat1 != 0xFFFFFFFF) {
+					uint32_t cagf = (rpstat1 >> 11) & 0x1FF;
+					actualMHz = (cagf * 50 + 1) / 3;
+				}
+				uint32_t rpnswreq = gpuRead(kGen6Rpnswreq);
+				if (rpnswreq != 0xFFFFFFFF) {
+					uint32_t req = (rpnswreq >> 23) & 0x1FF;
+					reqMHz = (req * 50 + 1) / 3;
+				}
+			}
+		}
+	}
+	setProperty("GPU Current Freq MHz", (unsigned long long)actualMHz, 32);
+	setProperty("GPU Requested Freq MHz", (unsigned long long)reqMHz, 32);
+	IOLockUnlock(gpuFreqLock);
+	return kIOReturnSuccess;
+}
