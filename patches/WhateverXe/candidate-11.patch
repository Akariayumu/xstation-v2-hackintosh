+  assert(TGLPowerFuseLog::classify(mask,UINT32_MAX)==TGLPowerFuseLog::InvalidMMIO);
+ }
+ for(uint32_t mask:{0U,1U<<26,1U<<22,3U<<24,UINT32_MAX})assert(TGLPowerFuseLog::well(mask)==3);
+ TGLPowerFuseLog log;
+ log.record(1U<<26,0,{0,10,1});log.record(0,0,{0,10,1});
+ for(auto v:log.q)assert(!v); // PG1 and unknown masks are not recorded
+ log.record(1U<<25,0,{1U<<25,30,3});log.record(1U<<25,1U<<25,{1U<<25,0,0});
+ log.record(1U<<24,0,{0,1000,100});log.record(1U<<23,0,{UINT32_MAX,20,2});
+ assert(log.q[0]==2 && log.q[4]==1 && log.q[8]==1 && log.q[9]==30 && log.q[10]==1000 && log.q[11]==20);
+ assert(log.q[12]==3 && log.q[13]==(2|2U<<8|2U<<16) && log.q[14]==UINT32_MAX && log.q[15]==20);
+ log.record(1U<<25,0,{1U<<25,10,1});assert(log.q[9]==30); // the peak keeps the maximum
+ puts("PASS: PG2/3/4 fuse result classes, InvalidMMIO, per-well peak and last event");
+}
diff -ruN base/tests/tgl_sink_state_trace.cpp cand11/tests/tgl_sink_state_trace.cpp
--- base/tests/tgl_sink_state_trace.cpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/tests/tgl_sink_state_trace.cpp	2026-10-28 02:42:05.000000000 +0900
@@ -0,0 +1,61 @@
+// Spec for the record-only eDP sink DPCD snapshot.
+#include "kern_tgl_sink_state_trace.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+using T=TGLSinkStateTrace;
+static T::Snapshot at(const uint8_t *out,uint32_t i){T::Snapshot s;memcpy(&s,out+8+size_t(i)*sizeof(s),sizeof(s));return s;}
+int main() {
+ // Regions are packed back to back and fit the data buffer.
+ uint32_t next=0;
+ for(uint32_t i=0;i<T::regionCount;i++){assert(T::regions[i].offset==next);next+=T::regions[i].length;}
+ assert(next==T::dataBytes && T::dataBytes<=sizeof(T::Snapshot{}.data));
+ // The addresses this experiment depends on are covered.
+ auto covers=[](uint32_t a){for(auto &r:T::regions)if(a>=r.address&&a<r.address+r.length)return true;return false;};
+ assert(covers(0x001) && covers(0x108) && covers(0x10A) && covers(0x115) && covers(0x300) && covers(0x600) && covers(0x700) && covers(0x2201));
+ // A healthy sink: every region read in order, data lands at its offset.
+ std::vector<uint32_t> seen;
+ T::Snapshot s{};
+ T::capture(s,[&](uint32_t a,uint8_t *b,uint32_t n){seen.push_back(a);memset(b,int(a&0xFF)|1,n);return 0U;});
+ assert(seen.size()==T::regionCount && seen[0]==0x0000 && seen[2]==0x0110 && seen[8]==0x2200);
+ assert(s.data[T::regions[2].offset+5]==(0x10|1) && s.result[8]==0);
+ // A sink that stops answering: the failing region is zeroed, the rest skipped.
+ seen.clear();T::Snapshot f{};
+ T::capture(f,[&](uint32_t a,uint8_t *b,uint32_t n){seen.push_back(a);memset(b,0xAA,n);return a==0x0100?0xe00002d6U:0U;});
+ assert(seen.size()==2 && f.result[0]==0 && f.result[1]==0xe00002d6U && f.result[2]==0xFFFFFFFFU && f.result[8]==0xFFFFFFFFU);
+ assert(f.data[T::regions[1].offset]==0 && f.data[T::regions[0].offset]==0xAA);
+ // First slots keep the boot snapshots; last slots wrap, oldest first.
+ T t;uint8_t out[T::bytes];
+ t.encode(out);uint32_t n,shape;memcpy(&n,out,4);memcpy(&shape,out+4,4);
+ assert(n==0 && shape==((T::firstSlots<<16)|T::lastSlots) && at(out,0).seq==0);
+ for(uint32_t i=0;i<T::firstSlots+T::lastSlots+3;i++){T::Snapshot x{};x.flags=i;x.ns=100+i;t.push(x);}
+ t.encode(out);memcpy(&n,out,4);assert(n==T::firstSlots+T::lastSlots+3);
+ for(uint32_t i=0;i<T::firstSlots;i++)assert(at(out,i).seq==i+1 && at(out,i).flags==i);
+ assert(at(out,T::firstSlots).seq==n-T::lastSlots+1 && at(out,T::firstSlots+T::lastSlots-1).seq==n);
+ // Encoding never changes the trace.
+ T copy=t;t.encode(out);assert(!memcmp(&copy,&t,sizeof(t)));
+ // Restore: no write when the sink already matches; written once on success;
+ // bounded retries with a wait after each failure; a failed read writes nothing.
+ uint8_t sink[3]{0,0,0};uint32_t writes=0,waits=0;bool fail=false;
+ auto rd=[&](uint32_t,uint8_t *b,uint32_t n){memcpy(b,sink,n);return 0U;};
+ auto wr=[&](uint32_t a,uint8_t *b,uint32_t n){++writes;assert(a==0x300||a==0x600||a==0x115);if(fail)return 0xe00002bcU;memcpy(sink,b,n);return 0U;};
+ auto wt=[&]{++waits;};
+ assert(T::restore(0x300,T::sourceOUI,3,3,rd,wr,wt)==1 && writes==1 && waits==0 && sink[1]==0xAA && sink[2]==0x01);
+ assert(T::restore(0x300,T::sourceOUI,3,3,rd,wr,wt)==0 && writes==1);
+ memset(sink,0,3);fail=true;writes=0;
+ assert(T::restore(0x600,T::setPowerD0,1,3,rd,wr,wt)==2 && writes==3 && waits==3 && sink[0]==0);
+ writes=0;assert(T::restore(0x600,T::setPowerD0,1,3,[](uint32_t,uint8_t *,uint32_t){return 0xe00002d6U;},wr,wt)==3 && writes==0);
+ assert(T::restore(0x600,T::setPowerD0,5,3,rd,wr,wt)==3);
+ // Firmware LINK_RATE_SET (5.4 Gbps index) written back after a power cycle reset it.
+ memset(sink,0,3);fail=false;writes=0;const uint8_t rate[1]{6};
+ assert(T::restore(0x115,rate,1,3,rd,wr,wt)==1 && sink[0]==6 && writes==1);
+ assert(T::restore(0x115,rate,1,3,rd,wr,wt)==0 && writes==1);
+ // Rate select against this panel's table (1.62 2.16 2.43 2.7 3.24 4.32 5.4 8.1 Gbps).
+ const uint8_t table[16]{0xa4,0x1f,0x30,0x2a,0x76,0x2f,0xbc,0x34,0x48,0x3f,0x60,0x54,0x78,0x69,0x34,0x9e};
+ assert(T::rateIndex(table,0x06)==0 && T::rateIndex(table,0x0a)==3 && T::rateIndex(table,0x14)==6 && T::rateIndex(table,0x1e)==7);
+ assert(T::rateIndex(table,0x00)==T::noRate && T::rateIndex(table,0x0c)==4 && T::rateIndex(table,0x0b)==T::noRate);
+ const uint8_t shortTable[16]{0x78,0x69,0,0,0x34,0x9e};
+ assert(T::rateIndex(shortTable,0x14)==0 && T::rateIndex(shortTable,0x1e)==T::noRate);
+ puts("PASS: sink state snapshot regions, capture, skip-after-failure, ring, encoding, restore, rate select");
+}
diff -ruN base/tests/tgl_timing_guard.cpp cand11/tests/tgl_timing_guard.cpp
--- base/tests/tgl_timing_guard.cpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/tests/tgl_timing_guard.cpp	2026-10-27 12:20:05.000000000 +0900
@@ -0,0 +1,69 @@
+// Specification of the TGL setupDisplayTiming output guard (pure helper).
+// The donor's setupDisplayTiming returns void and leaves its output untouched
+// when the AGDC timing request fails or returns an out-of-range index; its
+// caller still programs that output. The guard marks three probe fields
+// before the native call and, if none was written, substitutes the caller's
+// validated input, which is what the donor's own pass-through branch writes.
+#include "kern_tgl_timing_guard.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+using G=TGLTimingGuard;
+static const size_t probes[][2]={{0x28,8},{0x40,4},{0x50,4}};
+static void fill(uint8_t *t,uint8_t seed) {for(size_t i=0;i<G::size;++i)t[i]=uint8_t(seed+i*7);}
+static void timing(uint8_t *t,uint64_t clock,uint32_t h,uint32_t v) {
+ fill(t,0x31);std::memcpy(t+0x28,&clock,8);std::memcpy(t+0x40,&h,4);std::memcpy(t+0x50,&v,4);
+}
+int main() {
+ static_assert(G::size==0xA0,"IODetailedTimingInformationV2 size");
+ alignas(8) uint8_t in[G::size],out[G::size],before[G::size],expect[G::size];
+ timing(in,533250000,3840,2400);
+ // arm touches only the probe fields and makes them implausible as a timing.
+ fill(out,0x77);std::memcpy(before,out,G::size);G::arm(out);
+ for(size_t i=0,p=0;i<G::size;++i) {
+  const bool probe=(i>=0x28&&i<0x30)||(i>=0x40&&i<0x44)||(i>=0x50&&i<0x54);
+  if(!probe)assert(out[i]==before[i]);else ++p;
+  if(i==G::size-1)assert(p==16);
+ }
+ uint64_t clock;uint32_t h,v;std::memcpy(&clock,out+0x28,8);std::memcpy(&h,out+0x40,4);std::memcpy(&v,out+0x50,4);
+ assert(clock>100000000000ULL && h>0xFFFF && v>0xFFFF);
+ // Native wrote the whole result (memmove or field copy): transparent.
+ fill(out,0x77);G::arm(out);timing(expect,148500000,1920,1080);std::memcpy(out+0x0C,expect+0x0C,0x8A);
+ std::memcpy(before,out,G::size);
+ assert(G::settle(out,in)==G::Native && !std::memcmp(out,before,G::size));
+ // A native result equal to the input is still native, not a repair.
+ fill(out,0x77);G::arm(out);std::memcpy(out,in,G::size);
+ assert(G::settle(out,in)==G::Native && !std::memcmp(out,in,G::size));
+ // Native wrote nothing: the output becomes exactly the current input,
+ // independent of any earlier result (no snapshot reuse).
+ for(uint8_t seed:{0x00,0x77,0xFF}) {
+  fill(out,seed);G::arm(out);
+  assert(G::settle(out,in)==G::Repaired && !std::memcmp(out,in,G::size));
+ }
+ alignas(8) uint8_t in2[G::size];timing(in2,241500000,2560,1600);
+ std::memcpy(out,in,G::size);G::arm(out);
+ assert(G::settle(out,in2)==G::Repaired && !std::memcmp(out,in2,G::size));
+ // Partial overwrite cannot come from the donor (every success path writes
+ // all three probes). It is reported and still replaced by the input.
+ for(unsigned mask=1;mask<7;++mask) {
+  fill(out,0x55);G::arm(out);
+  for(unsigned i=0;i<3;++i)if(mask&(1U<<i))std::memcpy(out+probes[i][0],in2+probes[i][0],probes[i][1]);
+  assert(G::settle(out,in)==G::Inconsistent && !std::memcmp(out,in,G::size));
+ }
+ // A probe overwritten with only part of its width counts as written.
+ for(auto &p:probes)for(size_t b=0;b<p[1];++b) {
+  fill(out,0x55);G::arm(out);out[p[0]+b]^=0x01;
+  assert(G::settle(out,in)==G::Inconsistent && !std::memcmp(out,in,G::size));
+ }
+ // Arming would destroy an overlapping input, and a NULL pointer leaves no
+ // repair source: the wrapper then calls the donor without the guard.
+ alignas(8) uint8_t both[2*G::size];
+ assert(G::applicable(in,out) && G::applicable(out,in));
+ assert(G::applicable(both,both+G::size) && G::applicable(both+G::size,both));
+ for(size_t d:{size_t(0),size_t(1),size_t(0x50),G::size-1}) {
+  assert(!G::applicable(both,both+d) && !G::applicable(both+d,both));
+ }
+ assert(!G::applicable(nullptr,out) && !G::applicable(in,nullptr) && !G::applicable(nullptr,nullptr));
+ puts("PASS: probe arming, native transparency, current-input repair, partial overwrite and applicability");
+}
diff -ruN base/tests/tgl_timing_guard_native.py cand11/tests/tgl_timing_guard_native.py
