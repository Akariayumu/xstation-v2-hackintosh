diff -ruN '--exclude=build' base/WhateverXe/kern_tgl_backlight_trace.hpp cand11/WhateverXe/kern_tgl_backlight_trace.hpp
--- base/WhateverXe/kern_tgl_backlight_trace.hpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/WhateverXe/kern_tgl_backlight_trace.hpp	2026-10-27 21:38:05.000000000 +0900
@@ -0,0 +1,37 @@
+// Record-only trace of the four panel backlight registers the donor touches on
+// display-off (disableDisplay) and display-on (LightUpEDP): BLC_PWM_CTL
+// (0xC8250), BLC_PWM_FREQ (0xC8254), BLC_PWM_DUTY (0xC8258) and PP_CONTROL
+// (0xC7204). Each native write is appended after it has executed, with the
+// caller's image offset and a readback of CTL and PP_CONTROL. The ring keeps
+// the newest events. Nothing here issues a write or changes a donor decision.
+#ifndef KERN_TGL_BACKLIGHT_TRACE_HPP
+#define KERN_TGL_BACKLIGHT_TRACE_HPP
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+struct TGLBacklightTrace {
+ static constexpr uint32_t capacity=32;
+ struct Event {uint32_t seq,reg,value,caller,ctl,pp;uint64_t ns;};
+ static constexpr size_t bytes=8+size_t(capacity)*sizeof(Event);
+ static bool interesting(unsigned long reg) {return reg==0xC8250 || reg==0xC8254 || reg==0xC8258 || reg==0xC7204;}
+ uint32_t count {};
+ Event ring[capacity] {};
+ void push(uint32_t reg,uint32_t value,uint32_t caller,uint32_t ctl,uint32_t pp,uint64_t ns) {
+  const auto seq=__sync_fetch_and_add(&count,1);
+  Event e{seq+1,reg,value,caller,ctl,pp,ns};
+  ring[seq%capacity]=e;
+ }
+ // Layout: u32 count, u32 capacity, then the retained events oldest first.
+ void encode(uint8_t *out) const {
+  const uint32_t n=count,cap=capacity;
+  memcpy(out,&n,4);memcpy(out+4,&cap,4);
+  const uint32_t kept=n<cap ? n : cap;
+  for(uint32_t i=0;i<kept;i++) {
+   const uint32_t first=n<cap ? 0 : n-cap;
+   memcpy(out+8+size_t(i)*sizeof(Event),&ring[(first+i)%cap],sizeof(Event));
+  }
+  for(uint32_t i=kept;i<cap;i++)memset(out+8+size_t(i)*sizeof(Event),0,sizeof(Event));
+ }
+};
+static_assert(sizeof(TGLBacklightTrace::Event)==32,"event layout");
+#endif
diff -ruN '--exclude=build' base/WhateverXe/kern_tgl_display_on_trace.hpp cand11/WhateverXe/kern_tgl_display_on_trace.hpp
--- base/WhateverXe/kern_tgl_display_on_trace.hpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/WhateverXe/kern_tgl_display_on_trace.hpp	2026-10-27 22:25:10.000000000 +0900
@@ -0,0 +1,50 @@
+// Record-only trace for the display-off/on path: at every backlight register
+// write, at (rate-limited) failed AUX transactions and at every link training
+// return on the observed controller, read back the registers that decide
+// whether the eDP AUX channel can work at all (AUX power well request/state,
+// display power well 2, panel power status and control, combo PHY A lane
+// control, DDI_A buffer control, south HPD live state, PHY A misc power).
+// Reads only, newest events retained. Nothing here issues a write or changes
+// a donor decision.
+#ifndef KERN_TGL_DISPLAY_ON_TRACE_HPP
+#define KERN_TGL_DISPLAY_ON_TRACE_HPP
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+struct TGLDisplayOnTrace {
+ static constexpr uint32_t capacity=64;
+ enum Kind : uint32_t {BacklightWrite=1,AUXFailure=2,TrainingReturn=3,PanelPowerKeep=4,AUXSuccess=5};
+ struct Event {
+  uint32_t seq,kind,reg,value,caller;
+  uint32_t auxCtl,pwrAux,pwr2,ppStatus,ppControl,phyDW12,ddiBuf,hpd,phyMisc;
+  uint64_t ns;
+ };
+ static constexpr size_t bytes=8+size_t(capacity)*sizeof(Event);
+ // Registers read back after the event. AUX_CTL is per port (port+0x594).
+ static constexpr uint32_t regPwrAux=0x45444,regPwr2=0x45404,regPPStatus=0xC7200,regPPControl=0xC7204,
+  regPhyDW12=0x162030,regDDIBuf=0x64000,regHPD=0xC4000,regPhyMisc=0x64C00;
+ // AUX results are rate limited: the first `auxBurst` after a reset (training
+ // enter) are kept, then one in `auxEvery`. Non-AUX kinds are never dropped.
+ static constexpr uint32_t auxBurst=6,auxEvery=32;
+ uint32_t count {},auxSeen {};
+ Event ring[capacity] {};
+ void resetAUXWindow() {auxSeen=0;}
+ bool admitAUX() {
+  const auto n=__sync_fetch_and_add(&auxSeen,1);
+  return n<auxBurst || (n-auxBurst)%auxEvery==auxEvery-1;
+ }
+ void push(const Event &e) {
+  const auto seq=__sync_fetch_and_add(&count,1);
+  Event copy=e;copy.seq=seq+1;ring[seq%capacity]=copy;
+ }
+ // Layout: u32 count, u32 capacity, then the retained events oldest first.
+ void encode(uint8_t *out) const {
+  const uint32_t n=count,cap=capacity;
+  memcpy(out,&n,4);memcpy(out+4,&cap,4);
+  const uint32_t kept=n<cap ? n : cap,first=n<cap ? 0 : n-cap;
+  for(uint32_t i=0;i<kept;i++)memcpy(out+8+size_t(i)*sizeof(Event),&ring[(first+i)%cap],sizeof(Event));
+  for(uint32_t i=kept;i<cap;i++)memset(out+8+size_t(i)*sizeof(Event),0,sizeof(Event));
+ }
+};
+static_assert(sizeof(TGLDisplayOnTrace::Event)==64,"event layout");
+#endif
diff -ruN '--exclude=build' base/WhateverXe/kern_tgl_power_guard.hpp cand11/WhateverXe/kern_tgl_power_guard.hpp
--- base/WhateverXe/kern_tgl_power_guard.hpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/WhateverXe/kern_tgl_power_guard.hpp	2026-10-27 12:44:02.000000000 +0900
@@ -0,0 +1,32 @@
+// Record-only result of the PG2/3/4 fuse poll. It never changes the value
+// returned to the donor, the poll budget or any power request; a read of
+// all ones is kept apart because the donor's single-bit test accepts it.
+#ifndef KERN_TGL_POWER_GUARD_HPP
+#define KERN_TGL_POWER_GUARD_HPP
+#include "kern_xelp_donor.hpp"
+struct TGLPowerFuseLog {
+ enum Result : uint8_t {Ready,Timeout,InvalidMMIO};
+ // q[well*3+result] counts for PG2/PG3/PG4, q[9+well] maximum elapsed us,
+ // q[12] polls that had to wait, q[13..15] the last event (racy by design).
+ uint64_t q[16] {};
+ static Result classify(uint32_t mask,uint32_t value) {
+  return value==UINT32_MAX ? InvalidMMIO : (value&mask) ? Ready : Timeout;
+ }
+ static unsigned well(uint32_t mask) {
+  for(unsigned i=0;i<3;++i)if(mask==(1U<<(25-i)))return i;
+  return 3;
+ }
+ void record(uint32_t mask,uint32_t initial,const XELPDonor::Poll &poll) {
+  const auto w=well(mask);if(w>2)return;
+  const auto result=classify(mask,poll.value);
+  __atomic_fetch_add(&q[w*3+result],1,__ATOMIC_RELAXED);
+  auto peak=__atomic_load_n(&q[9+w],__ATOMIC_RELAXED);
+  while(poll.elapsedUs>peak && !__atomic_compare_exchange_n(&q[9+w],&peak,uint64_t(poll.elapsedUs),
+        true,__ATOMIC_RELAXED,__ATOMIC_RELAXED)) {}
+  if(poll.reads)__atomic_fetch_add(&q[12],1,__ATOMIC_RELAXED);
+  __atomic_store_n(&q[13],uint64_t(w)|uint64_t(result)<<8|uint64_t(poll.reads)<<16,__ATOMIC_RELAXED);
+  __atomic_store_n(&q[14],uint64_t(initial)<<32|poll.value,__ATOMIC_RELAXED);
+  __atomic_store_n(&q[15],uint64_t(poll.elapsedUs),__ATOMIC_RELAXED);
+ }
+};
+#endif
diff -ruN '--exclude=build' base/WhateverXe/kern_tgl_sink_state_trace.hpp cand11/WhateverXe/kern_tgl_sink_state_trace.hpp
--- base/WhateverXe/kern_tgl_sink_state_trace.hpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/WhateverXe/kern_tgl_sink_state_trace.hpp	2026-10-28 02:41:48.000000000 +0900
@@ -0,0 +1,100 @@
+// Record-only snapshot of eDP sink (panel) DPCD state taken right before each
+// native link training on the observed internal panel port. The firmware
+// leaves the panel configured at boot; a real panel power cycle resets it to
+// its own defaults. Comparing the boot snapshot with a post-power-cycle one
+// shows which sink state the donor never restores. Only DPCD reads through the
+// donor's own AUX read routine; nothing here writes the sink or the source.
+#ifndef KERN_TGL_SINK_STATE_TRACE_HPP
+#define KERN_TGL_SINK_STATE_TRACE_HPP
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+struct TGLSinkStateTrace {
+ struct Region {uint32_t address,length,offset;};
+ // Receiver caps, link configuration (incl. 0x108 coding, 0x10A eDP config,
+ // 0x115 link rate set), lane status, source OUI, sink power, eDP caps,
+ // eDP display control and the extended receiver caps.
+ static constexpr uint32_t regionCount=9;
+ static constexpr Region regions[regionCount] {
+  {0x0000,16,0},{0x0100,16,16},{0x0110,8,32},{0x0200,8,40},{0x0300,12,48},
+  {0x0600,1,60},{0x0700,8,61},{0x0720,4,69},{0x2200,16,73}};
+ static constexpr uint32_t dataBytes=89;
+ struct Snapshot {
+  uint32_t seq,flags;              // flags bit0: panel power keep, bit1: D0 restore, bit2: OUI restore, bit3: rate select, bit4: rate restore
+  uint64_t ns;
+  uint32_t result[regionCount];    // IOReturn per region, 0xFFFFFFFF = skipped
+  uint32_t reserved;               // explicit padding, always zero
+  uint8_t data[96];                // regions packed at Region::offset
+ };
+ static constexpr uint32_t firstSlots=4,lastSlots=8;
+ static constexpr size_t bytes=8+size_t(firstSlots+lastSlots)*sizeof(Snapshot);
+ uint32_t count {};
+ Snapshot first[firstSlots] {},last[lastSlots] {};
+ // Fills one snapshot. read(address,buffer,length) returns an IOReturn. After
+ // the first failed read the remaining regions are skipped so a sink that does
+ // not answer AUX does not add a timeout per region.
+ template<class Read> static void capture(Snapshot &s,Read read) {
+  bool failed=false;
+  for(uint32_t i=0;i<regionCount;i++) {
+   if(failed){s.result[i]=0xFFFFFFFFU;continue;}
+   const auto &r=regions[i];
+   s.result[i]=read(r.address,s.data+r.offset,r.length);
+   if(s.result[i]){memset(s.data+r.offset,0,r.length);failed=true;}
+  }
+ }
+ // Restores sink bytes a real panel power cycle resets and the donor never
+ // writes back (opt-in experiment, one boot-arg per item). Reads first and
+ // writes only when the sink differs, retrying like Linux intel_dp_set_power.
+ // Returns 0 when already correct, 1 when written, 2 when every try failed,
+ // 3 when the read failed.
+ template<class Read,class Write,class Wait> static uint32_t restore(uint32_t address,const uint8_t *want,
+  uint32_t length,uint32_t tries,Read read,Write write,Wait wait) {
+  uint8_t have[4] {};
+  if(length>sizeof(have) || read(address,have,length))return 3;
+  if(!memcmp(have,want,length))return 0;
+  for(uint32_t i=0;i<tries;i++) {
+   uint8_t copy[4];memcpy(copy,want,length);
+   if(!write(address,copy,length))return 1;
+   wait();
+  }
+  return 2;
+ }
+ static constexpr uint8_t setPowerD0[1] {1};
+ // Intel source OUI, as the firmware (and Linux i915) write it.
+ static constexpr uint8_t sourceOUI[3] {0x00,0xAA,0x01};
+ // eDP 1.4 rate select: index of a LINK_BW_SET code in the sink's
+ // SUPPORTED_LINK_RATES table (DPCD 0x010, 8 little-endian entries in 200 kHz
+ // units, zero-terminated), or noRate when the table does not list it.
+ static constexpr uint8_t noRate=0xFF;
+ static uint8_t rateIndex(const uint8_t table[16],uint8_t bwCode) {
+  const uint32_t want=uint32_t(bwCode)*1350;
+  for(uint8_t i=0;i<8;i++) {
+   const uint32_t v=table[2*i]|(uint32_t(table[2*i+1])<<8);
+   if(!v)break;
+   if(v==want)return i;
+  }
+  return noRate;
+ }
+ void push(const Snapshot &s) {
+  const auto seq=__sync_add_and_fetch(&count,1);
+  Snapshot copy=s;copy.seq=seq;
+  if(seq<=firstSlots)first[seq-1]=copy;
+  last[(seq-1)%lastSlots]=copy;
+ }
+ // Layout: u32 count, u32 (firstSlots<<16|lastSlots), first[] in order, then
+ // the retained last[] oldest first; unused slots are zero.
+ void encode(uint8_t *out) const {
+  const uint32_t n=count,shape=(firstSlots<<16)|lastSlots;
+  memcpy(out,&n,4);memcpy(out+4,&shape,4);
+  auto p=out+8;
+  for(uint32_t i=0;i<firstSlots;i++,p+=sizeof(Snapshot)) {
+   if(i<n)memcpy(p,&first[i],sizeof(Snapshot));else memset(p,0,sizeof(Snapshot));
+  }
+  const uint32_t kept=n<lastSlots?n:lastSlots,start=n<lastSlots?0:n-lastSlots;
+  for(uint32_t i=0;i<lastSlots;i++,p+=sizeof(Snapshot)) {
+   if(i<kept)memcpy(p,&last[(start+i)%lastSlots],sizeof(Snapshot));else memset(p,0,sizeof(Snapshot));
+  }
+ }
+};
+static_assert(sizeof(TGLSinkStateTrace::Snapshot)==152,"snapshot layout");
+#endif
diff -ruN '--exclude=build' base/WhateverXe/kern_tgl_timing_guard.hpp cand11/WhateverXe/kern_tgl_timing_guard.hpp
--- base/WhateverXe/kern_tgl_timing_guard.hpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/WhateverXe/kern_tgl_timing_guard.hpp	2026-10-27 12:27:00.000000000 +0900
@@ -0,0 +1,37 @@
+// Output guard for AppleIntelFramebuffer::setupDisplayTiming. The donor
+// returns void and writes nothing when its AGDC timing request fails or
+// yields an out-of-range index, yet setDisplayMode programs that output.
+// Every successful donor path writes the three probe fields below.
+#ifndef KERN_TGL_TIMING_GUARD_HPP
+#define KERN_TGL_TIMING_GUARD_HPP
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+struct TGLTimingGuard {
+ static constexpr size_t size=0xA0; // IODetailedTimingInformationV2
+ enum Outcome : uint8_t {Native,Repaired,Inconsistent};
+ // 0xFE in every byte: pixelClock above 18 EHz, active sizes above 4G.
+ static constexpr uint8_t mark=0xFE;
+ static bool applicable(const uint8_t *in,const uint8_t *out) {
+  return in && out && (in+size<=out || out+size<=in);
+ }
+ static void arm(uint8_t *out) {
+  const size_t probe[3][2]={{0x28,8},{0x40,4},{0x50,4}}; // pixelClock, horizontal/verticalActive
+  for(auto &p:probe)memset(out+p[0],mark,p[1]);
+ }
+ static Outcome settle(uint8_t *out,const uint8_t *in) {
+  const size_t probe[3][2]={{0x28,8},{0x40,4},{0x50,4}};
+  unsigned kept=0;
+  for(auto &p:probe) {
+   bool same=true;
+   for(size_t i=0;i<p[1];++i)same=same && out[p[0]+i]==mark;
+   kept+=same;
+  }
+  if(!kept)return Native;
+  // Same result as the donor's own pass-through branch: the caller's
+  // validated timing for this request, never an older snapshot.
+  memcpy(out,in,size);
+  return kept==3 ? Repaired : Inconsistent;
+ }
+};
+#endif
diff -ruN '--exclude=build' base/WhateverXe/kern_tgl_wake_index.hpp cand11/WhateverXe/kern_tgl_wake_index.hpp
--- base/WhateverXe/kern_tgl_wake_index.hpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/WhateverXe/kern_tgl_wake_index.hpp	2026-10-27 20:40:07.000000000 +0900
@@ -0,0 +1,48 @@
+// Record-only snapshot of the framebuffer state that prepareToEnterWake and
+// recoverDPLink consult instead of calling setupDisplayTiming: the AGDC entry
+// index (fb+0x3FD8), the flag bytes that select the rebuild path, the mode id
+// handed to validateDisplayMode, and the timing stored in the indexed entry.
+// Nothing here writes to the framebuffer or changes any donor decision.
+#ifndef KERN_TGL_WAKE_INDEX_HPP
+#define KERN_TGL_WAKE_INDEX_HPP
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+struct TGLWakeIndex {
+ // Donor wake logic: idx==-1 selects fb+0x1E6, otherwise fb+0x1E4. A set flag
+ // rebuilds the timing from entry idx (path A; idx==-1 reads before the
+ // object, A1); a clear flag re-validates fb+0x4250 (path B).
+ enum Path : uint8_t {B,A,A1,Unknown};
+ static constexpr size_t entryStride=0x3DC,entryBase=0x2A5; // out[k] <- fb[base+idx*stride+k]
+ struct Snapshot {
+  int32_t index;uint32_t entries;uint8_t flag1E4,flag1E6,flag1EA;uint32_t mode;
+  uint64_t entryClock;uint32_t entryH,entryV;
+ };
+ static Snapshot take(const uint8_t *fb) {
+  Snapshot s {};
+  memcpy(&s.index,fb+0x3FD8,4);memcpy(&s.entries,fb+0x209,4);
+  s.flag1E4=fb[0x1E4];s.flag1E6=fb[0x1E6];s.flag1EA=fb[0x1EA];
+  memcpy(&s.mode,fb+0x4250,4);
+  if(s.index>=0 && uint32_t(s.index)<s.entries) {
+   const auto e=fb+entryBase+size_t(s.index)*entryStride;
+   memcpy(&s.entryClock,e+0x28,8);memcpy(&s.entryH,e+0x40,4);memcpy(&s.entryV,e+0x50,4);
+  }
+  return s;
+ }
+ static Path predict(const Snapshot &s) {
+  if(s.index==-1)return s.flag1E6 ? A1 : B;
+  if(!s.flag1E4)return B;
+  if(s.index<0)return A1; // any negative index rebuilds from before the object
+  return uint32_t(s.index)<s.entries ? A : Unknown;
+ }
+ // 8 x uint64: index before/after, flags, mode|entries, entry timing, native count, paths.
+ static void encode(uint64_t r[8],const Snapshot &before,const Snapshot &after,uint32_t nativeCount) {
+  r[0]=uint64_t(int64_t(before.index));r[1]=uint64_t(int64_t(after.index));
+  r[2]=uint64_t(before.flag1E4)|uint64_t(before.flag1E6)<<8|uint64_t(before.flag1EA)<<16|
+       uint64_t(after.flag1E4)<<24|uint64_t(after.flag1E6)<<32|uint64_t(after.flag1EA)<<40;
+  r[3]=uint64_t(after.mode)|uint64_t(after.entries)<<32;
+  r[4]=after.entryClock;r[5]=uint64_t(after.entryH)|uint64_t(after.entryV)<<32;
+  r[6]=nativeCount;r[7]=uint64_t(predict(after))|uint64_t(predict(before))<<8;
+ }
+};
+#endif
