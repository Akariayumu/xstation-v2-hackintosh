+++ cand11/tests/tgl_backlight_trace.cpp	2026-10-27 21:50:09.000000000 +0900
@@ -0,0 +1,29 @@
+// Spec for the record-only backlight register trace.
+#include "kern_tgl_backlight_trace.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+using T=TGLBacklightTrace;
+static T::Event at(const uint8_t *out,uint32_t i){T::Event e;memcpy(&e,out+8+size_t(i)*sizeof(T::Event),sizeof(e));return e;}
+int main() {
+ assert(T::interesting(0xC8250) && T::interesting(0xC8254) && T::interesting(0xC8258) && T::interesting(0xC7204));
+ assert(!T::interesting(0xC8260) && !T::interesting(0x70008) && !T::interesting(0));
+ T t;uint8_t out[T::bytes];
+ // Empty: header only, every slot zero.
+ t.encode(out);uint32_t n,cap;memcpy(&n,out,4);memcpy(&cap,out+4,4);
+ assert(n==0 && cap==T::capacity && at(out,0).seq==0 && at(out,T::capacity-1).seq==0);
+ // The donor's display-on order: period, duty, then CTL enable from LightUpEDP.
+ t.push(0xC8254,0x4571,0x507d1,0,0,100);
+ t.push(0xC8258,0x156a,0x4a5c5,0,0,110);
+ t.push(0xC8250,0x80000000,0x507f9,0x80000000,0xC,120);
+ t.encode(out);memcpy(&n,out,4);assert(n==3);
+ auto e=at(out,2);assert(e.seq==3 && e.reg==0xC8250 && e.value==0x80000000 && e.caller==0x507f9 && e.ctl==0x80000000 && e.pp==0xC && e.ns==120);
+ assert(at(out,0).reg==0xC8254 && at(out,1).reg==0xC8258 && at(out,3).seq==0);
+ // Wrap: after more than capacity events the newest are kept, oldest first.
+ for(uint32_t i=0;i<T::capacity+5;i++)t.push(0xC8258,i,0x4a5c5,0,0,1000+i);
+ t.encode(out);memcpy(&n,out,4);assert(n==3+T::capacity+5);
+ assert(at(out,0).seq==n-T::capacity+1 && at(out,T::capacity-1).seq==n && at(out,T::capacity-1).value==T::capacity+4);
+ // Encoding never changes the trace.
+ T copy=t;t.encode(out);assert(!memcmp(&copy,&t,sizeof(t)));
+ puts("PASS: backlight trace ring, order, wrap, encoding");
+}
