@@ -3025,12 +3033,37 @@
 TGLConnectionRecord tglConnectionLast[tglConnectionEvents][tglConnectionCapacity] {};
 uint32_t tglConnectionCounts[tglConnectionEvents] {}, tglConnectionSequence {};
 
+// Newest backlight register writes (display-off/on), see kern_tgl_backlight_trace.hpp.
+TGLBacklightTrace tglBacklightTrace;
 uint32_t tglConnectionCaller(void *caller) {
 	const auto pc = reinterpret_cast<uintptr_t>(caller);
 	return pc >= tglConnectionImage && pc - tglConnectionImage < tglConnectionImageSize
 		? static_cast<uint32_t>(pc - tglConnectionImage) : 0xFFFFFFFFU;
 }
 
+// Display-on readback trace (record-only), see kern_tgl_display_on_trace.hpp.
+TGLDisplayOnTrace tglDisplayOnTrace;
+TGLSinkStateTrace tglSinkStateTrace;
+// -wex-no-panel-keep: leave the donor panel power-down untouched (experiment
+// switch; default keeps the panel powered).
+bool tglPanelKeepDisabled;
+// -wex-sink-d0 / -wex-sink-oui: before native training on the internal panel,
+// restore DPCD SET_POWER D0 / the Intel source OUI when the sink lost them.
+bool tglSinkRestoreD0,tglSinkRestoreOUI;
+// -wex-sink-rate-select: on the internal panel, program the donor's LINK_BW_SET
+// choice as eDP 1.4 rate select (LINK_BW_SET 0 + LINK_RATE_SET index), as the
+// firmware and Linux do.
+bool tglSinkRateSelect;
+// LINK_BW_SET code the donor asked for in the last converted write. The donor
+// reads LINK_BW_SET back (hwCRTCToIODetailedTimingInformation) to derive the
+// pixel clock; with rate select the sink holds 0 there, so that readback is
+// answered with this code. WEX's own snapshot reads bypass the translation.
+uint8_t tglRateSelectCode;
+// -wex-sink-rate-restore: restore the LINK_RATE_SET value the firmware left
+// (first snapshot) before each native training when a panel power cycle lost it.
+bool tglSinkRestoreRate;
+
+
 // Retain issued display programming order independently of cursor/flip traffic.
 // No MMIO reads, allocations or publication on the native write paths. These
 // are requests at the wrapper boundary, not proof that hardware latched them.
@@ -10417,6 +10450,45 @@
 				patcher.clearError();
 			}
 
+			if (tglActive && checkKernelArgument("-wex-tgl-sdt-guard")) {
+				// setupDisplayTiming returns void and writes nothing when the AGDC
+				// timing request fails or its index is out of range; setDisplayMode
+				// still programs that stack output. Exact Sequoia Graphics 0.2.0
+				// donor and physical TGL B0 only. Relocated memmove bytes excluded.
+				const char *symbol="__ZN21AppleIntelFramebuffer18setupDisplayTimingEPK29IODetailedTimingInformationV2PS0_";
