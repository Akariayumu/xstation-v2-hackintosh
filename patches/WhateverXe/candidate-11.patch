+import argparse,hashlib,subprocess,tempfile
+p=argparse.ArgumentParser(description=__doc__);p.add_argument('donor',type=Path)
+p.add_argument('--native-only',action='store_true',help='prove the donor behaviour without the guard')
+a=p.parse_args()
+# Graphics 0.2.0 Sequoia AppleIntelTGLGraphicsFramebuffer, UUID B6078743-...-0949.
+if hashlib.sha256(a.donor.read_bytes()).hexdigest()!='909847cd017dfb2f693cc2c78c5dc20fed4a0a24fb4e94c22e12605b53849cea':p.error('unqualified donor SHA256')
+r=Path(__file__).resolve().parents[1]
