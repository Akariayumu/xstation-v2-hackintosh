+ d=Path(d);flags=['-DNATIVE_ONLY'] if a.native_only else []
+ subprocess.run(['clang++','-arch','x86_64','-std=c++14','-O1','-g',*flags,'-I',str(r/'WhateverXe'),str(r/'tests/tgl_timing_guard_native_fixture.cpp'),'-o',str(d/'check')],check=True)
+ subprocess.run([str(d/'check'),str(a.donor.resolve())],check=True)
diff -ruN base/tests/tgl_timing_guard_native_fixture.cpp cand11/tests/tgl_timing_guard_native_fixture.cpp
--- base/tests/tgl_timing_guard_native_fixture.cpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/tests/tgl_timing_guard_native_fixture.cpp	2026-10-27 12:21:22.000000000 +0900
@@ -0,0 +1,120 @@
+// Executes the exact donor AppleIntelFramebuffer::setupDisplayTiming with a
+// mocked AGDC callback, first alone and then wrapped by TGLTimingGuard.
+// The native run is the oracle: success must leave every byte identical
+// with and without the guard; failure must leave the output untouched by the
+// donor and equal to the validated input with the guard, with no other change.
+#ifndef NATIVE_ONLY
+#include "kern_tgl_timing_guard.hpp"
+#endif
+#include <cassert>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <initializer_list>
+#include <vector>
+#include <sys/mman.h>
+constexpr size_t TimingSize=0xA0,Entry=0x3DC;
+alignas(16) uint8_t fb[0x5000],controller[0x2000],in[TimingSize],out[TimingSize],request[0xB0];
+uint8_t token;
+unsigned bzeros,moves,logs,disables,dbufs,resources,agdcs;
+bool agdcResult;int32_t agdcIndex;
+void bzeroMock(void *p,size_t n){assert(n==0xB0);++bzeros;std::memset(p,0,n);}
+void *memmoveMock(void *d,const void *s,size_t n){assert(d==out && s==in && n==TimingSize);++moves;return std::memmove(d,s,n);}
+void logMock(const char *,...){++logs;}
+void disableMock(void *p,bool b){assert(p==fb && !b);++disables;}
+void dbufMock(void *p){assert(p==controller);++dbufs;}
+void resourcesMock(void *p){assert(p==fb);++resources;}
+bool agdcMock(void *ctx,uint8_t *req,uint32_t zero,uint32_t op) {
+ assert(ctx==&token && zero==0 && op==0xC);++agdcs;
+ std::memcpy(request,req,sizeof(request));std::memcpy(req+0xAC,&agdcIndex,4);
+ return agdcResult;
+}
+void jump(uint8_t *p,uintptr_t t){p[0]=0x48;p[1]=0xb8;std::memcpy(p+2,&t,8);p[10]=0xff;p[11]=0xe0;}
+void callTo(uint8_t *m,unsigned site,unsigned expected,unsigned target) {
+ int32_t rel;assert(m[site]==0xe8);std::memcpy(&rel,m+site+1,4);
+ assert(site+5+rel==expected); // relocated externals encode the next instruction
+ rel=target-site-5;std::memcpy(m+site+1,&rel,4);
+}
+template<class T> void put(size_t o,T v){std::memcpy(fb+o,&v,sizeof(v));}
+template<class T> T get(const uint8_t *p,size_t o){T v;std::memcpy(&v,p+o,sizeof(v));return v;}
+enum Path {PassThrough,Fields,Flag2};
+struct Case {bool result;int32_t index;Path path;bool flag1e9,wide,flag1ea;int32_t previous;};
+void prepare(const Case &c,uint8_t garbage) {
+ bzeros=moves=logs=disables=dbufs=resources=agdcs=0;agdcResult=c.result;agdcIndex=c.index;
+ for(size_t i=0;i<sizeof(fb);++i)fb[i]=uint8_t(i*13+5);
+ put<void*>(0x1D0,controller);put<uint32_t>(0x1DC,0x1234);put<int32_t>(0x4250,-3);put<uint32_t>(0x209,2);
+ for(size_t e=0;e<2;++e) {
+  put<uint8_t>(0x21D+e*Entry,c.path==Flag2?2:0);put<uint32_t>(0x28D+e*Entry,c.path==PassThrough?0:1);
+ }
+ put<uint8_t>(0x1E9,c.flag1e9);put<uint8_t>(0x1EA,c.flag1ea);put<int32_t>(0x3FD8,c.previous);
+ *reinterpret_cast<bool(**)(void*,uint8_t*,uint32_t,uint32_t)>(controller+0x1BF8)=agdcMock;
+ *reinterpret_cast<void**>(controller+0x1C00)=&token;
+ for(size_t i=0;i<TimingSize;++i)in[i]=uint8_t(0x40+i);
+ const uint64_t clock=c.wide?533250000:148500000;const uint32_t h=c.wide?3840:1920,v=c.wide?2400:1080;
+ std::memcpy(in+0x28,&clock,8);std::memcpy(in+0x40,&h,4);std::memcpy(in+0x50,&v,4);
+ std::memset(out,garbage,sizeof(out));
+}
+struct Snapshot {
+ std::vector<uint8_t> frame,output;unsigned counts[7];
+ static Snapshot take(){return {{fb,fb+sizeof(::fb)},{out,out+TimingSize},{bzeros,moves,logs,disables,dbufs,resources,agdcs}};}
+ bool operator==(const Snapshot &o)const{return frame==o.frame && output==o.output && !std::memcmp(counts,o.counts,sizeof(counts));}
+};
+int main(int argc,char **argv) {
+ assert(argc==2);std::ifstream f(argv[1],std::ios::binary);std::vector<char> b((std::istreambuf_iterator<char>(f)),{});
+ const size_t size=4*1024*1024;assert(b.size()==0x2CEA70);
+ auto m=static_cast<uint8_t*>(mmap(nullptr,size,PROT_READ|PROT_WRITE|PROT_EXEC,MAP_PRIVATE|MAP_ANON,-1,0));
+ assert(m!=MAP_FAILED);std::memcpy(m,b.data(),b.size());
+ const uintptr_t mocks[]={(uintptr_t)bzeroMock,(uintptr_t)logMock,(uintptr_t)memmoveMock,(uintptr_t)disableMock,(uintptr_t)dbufMock,(uintptr_t)resourcesMock};
+ for(unsigned i=0;i<6;++i)jump(m+0x300000+0x20*i,mocks[i]);
+ callTo(m,0x6817D,0x68182,0x300000);callTo(m,0x68524,0x68529,0x300020);callTo(m,0x6854C,0x68551,0x300020);
+ callTo(m,0x68804,0x68809,0x300040);callTo(m,0x688A3,0x68900,0x300060);callTo(m,0x688AF,0x54754,0x300080);
+ callTo(m,0x688EA,0x670BA,0x3000A0);
+ const auto native=reinterpret_cast<void(*)(void*,const void*,void*)>(m+0x6814C);
+ unsigned successes=0,failures=0;
+ for(bool result:{false,true})for(int32_t index:{0,1,2,-1,7})for(Path path:{PassThrough,Fields,Flag2})
+ for(bool f1e9:{false,true})for(bool wide:{false,true})for(bool f1ea:{false,true})for(int32_t previous:{-1,0,1}) {
+  const Case c{result,index,path,f1e9,wide,f1ea,previous};
+  const bool success=result && uint32_t(index)<2;
+  for(uint8_t garbage:{0x00,0xA5}) {
+   prepare(c,garbage);const auto initial=Snapshot::take();
+   native(fb,in,out);const auto plain=Snapshot::take();
+   assert(agdcs==1 && bzeros==1);
+   assert(get<uint32_t>(request,0)==0x1234 && get<int64_t>(request,4)==-3);
+   assert(!std::memcmp(request+0x10,in+0x0C,0x7C) && get<uint64_t>(request,0x2C)==get<uint64_t>(in,0x28));
+   if(!success) {
+    // Native counterexample: the output stays as the caller left it, and
+    // nothing else moves, yet setDisplayMode still programs this output.
+    assert(plain.frame==initial.frame && plain.output==initial.output);
+    assert(logs==1 && !moves && !resources && !disables && !dbufs);
+   } else {
+    assert(!logs && resources==1 && get<int32_t>(fb,0x3FD8)==index);
+    for(size_t o:{size_t(0x28),size_t(0x40),size_t(0x50)}) {
+     bool written=false;for(size_t i=0;i<4;++i)written|=out[o+i]!=garbage;assert(written);
+    }
+    assert(moves==(path==PassThrough?1u:0u));
+    if(path==PassThrough)assert(!std::memcmp(out,in,TimingSize));
+   }
+#ifndef NATIVE_ONLY
+   prepare(c,garbage);
+   assert(TGLTimingGuard::applicable(in,out));
+   TGLTimingGuard::arm(out);native(fb,in,out);
+   const auto outcome=TGLTimingGuard::settle(out,in);const auto guarded=Snapshot::take();
+   if(success) {
+    assert(outcome==TGLTimingGuard::Native && guarded==plain);
+   } else {
+    assert(outcome==TGLTimingGuard::Repaired && !std::memcmp(out,in,TimingSize));
+    assert(guarded.frame==plain.frame && !std::memcmp(guarded.counts,plain.counts,sizeof(plain.counts)));
+   }
+#endif
+  }
+  success ? ++successes : ++failures;
+ }
+ assert(successes==2*3*2*2*2*3 && failures==8*3*2*2*2*3);
+#ifdef NATIVE_ONLY
+ printf("PASS native-only: %u success and %u failure cases; failure leaves output and framebuffer untouched\n",successes,failures);
+#else
+ printf("PASS: %u success cases transparent, %u failure cases repaired from the current input only\n",successes,failures);
+#endif
+}
diff -ruN base/tests/tgl_wake_index.cpp cand11/tests/tgl_wake_index.cpp
--- base/tests/tgl_wake_index.cpp	1970-01-01 09:00:00.000000000 +0900
+++ cand11/tests/tgl_wake_index.cpp	2026-10-27 20:40:07.000000000 +0900
@@ -0,0 +1,52 @@
+// Spec for the record-only wake index snapshot (B5 diagnostic).
+#include "kern_tgl_wake_index.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+using W=TGLWakeIndex;
+static std::vector<uint8_t> frame(uint32_t entries) {
+ std::vector<uint8_t> fb(W::entryBase+size_t(entries)*W::entryStride+0xA0);
+ if(fb.size()<0x4260)fb.resize(0x4260);
+ memcpy(fb.data()+0x209,&entries,4);
+ return fb;
+}
+static void setIndex(std::vector<uint8_t> &fb,int32_t idx){memcpy(fb.data()+0x3FD8,&idx,4);}
+static void setEntry(std::vector<uint8_t> &fb,uint32_t idx,uint64_t clock,uint32_t h,uint32_t v) {
+ auto e=fb.data()+W::entryBase+size_t(idx)*W::entryStride;
+ memcpy(e+0x28,&clock,8);memcpy(e+0x40,&h,4);memcpy(e+0x50,&v,4);
+}
+int main() {
+ // Fresh object: index -1, every flag clear -> path B, no entry read.
+ auto fb=frame(3);setIndex(fb,-1);
+ auto s=W::take(fb.data());
+ assert(s.index==-1 && s.entries==3 && !s.flag1E4 && !s.flag1E6 && !s.entryClock && W::predict(s)==W::B);
+ // Index -1 with fb+0x1E6 set: the donor would rebuild from before the object (A1).
+ fb[0x1E6]=1;s=W::take(fb.data());assert(W::predict(s)==W::A1 && !s.entryClock);
+ fb[0x1E6]=0;
+ // allocateBootDisplayResources wrote 0 but setupDisplayTiming never succeeded: fb+0x1E4 clear -> B.
+ setIndex(fb,0);setEntry(fb,0,0,0,0);s=W::take(fb.data());assert(s.index==0 && W::predict(s)==W::B);
+ // One success: index 2, flag set, entry carries the timing -> A, entry timing visible.
+ setIndex(fb,2);fb[0x1E4]=1;fb[0x1EA]=1;setEntry(fb,2,592500000,3840,2400);
+ const uint32_t mode=0x80001000;memcpy(fb.data()+0x4250,&mode,4);
+ s=W::take(fb.data());
+ assert(W::predict(s)==W::A && s.entryClock==592500000 && s.entryH==3840 && s.entryV==2400 && s.mode==mode && s.flag1EA==1);
+ // Index at or beyond the entry count is never dereferenced.
+ setIndex(fb,3);s=W::take(fb.data());assert(W::predict(s)==W::Unknown && !s.entryClock && !s.entryH);
+ setIndex(fb,-7);s=W::take(fb.data());assert(W::predict(s)==W::A1 && !s.entryClock); // flag set, negative index
+ fb[0x1E4]=0;s=W::take(fb.data());assert(W::predict(s)==W::B);fb[0x1E4]=1;
+ // Zero entries: index 0 is out of range.
+ auto empty=frame(0);setIndex(empty,0);empty[0x1E4]=1;s=W::take(empty.data());
+ assert(W::predict(s)==W::Unknown && !s.entryClock);
+ // Encoding: before/after, packed flags, mode|entries, entry timing, native count, paths.
+ setIndex(fb,2);auto before=W::take(fb.data());
+ fb[0x1E6]=1;setIndex(fb,-1);auto after=W::take(fb.data());
+ uint64_t r[8];W::encode(r,before,after,41);
+ assert(r[0]==2 && r[1]==uint64_t(-1) && r[2]==(1ULL|1ULL<<16|1ULL<<24|1ULL<<32|1ULL<<40));
+ assert(r[3]==(uint64_t(mode)|3ULL<<32) && r[4]==0 && r[5]==0 && r[6]==41 && r[7]==(uint64_t(W::A1)|uint64_t(W::A)<<8));
+ W::encode(r,after,before,0);
+ assert(r[4]==592500000 && r[5]==(3840ULL|2400ULL<<32) && r[7]==(uint64_t(W::A)|uint64_t(W::A1)<<8));
+ // take() never writes.
+ auto copy=fb;W::take(fb.data());assert(copy==fb);
+ puts("PASS: wake index snapshot, path prediction, bounded entry read, encoding");
+}
