@@ -0,0 +1,34 @@
+// Spec for the record-only display-on readback trace.
+#include "kern_tgl_display_on_trace.hpp"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+using T=TGLDisplayOnTrace;
+static T::Event at(const uint8_t *out,uint32_t i){T::Event e;memcpy(&e,out+8+size_t(i)*sizeof(T::Event),sizeof(e));return e;}
+int main() {
+ T t;uint8_t out[T::bytes];
+ t.encode(out);uint32_t n,cap;memcpy(&n,out,4);memcpy(&cap,out+4,4);
+ assert(n==0 && cap==T::capacity && at(out,0).seq==0);
+ // A failed AUX transaction with the AUX well off reads back all-ones.
+ T::Event e{};e.kind=T::AUXFailure;e.reg=0x64010;e.value=0xe00002d6;e.caller=0x61ad1;
+ e.auxCtl=0xFFFFFFFF;e.pwrAux=0;e.pwr2=0x8f000000;e.ppStatus=0x80000008;e.ppControl=0x63;e.phyDW12=0xFFFFFFFF;e.ddiBuf=0;e.hpd=0x01000000;e.phyMisc=0x23000000;e.ns=5;
+ t.push(e);
+ T::Event b{};b.kind=T::BacklightWrite;b.reg=0xC8250;b.value=0x80000000;b.caller=0x507f9;b.ns=6;t.push(b);
+ t.encode(out);memcpy(&n,out,4);assert(n==2);
+ auto r=at(out,0);assert(r.seq==1 && r.kind==T::AUXFailure && r.auxCtl==0xFFFFFFFF && r.ppStatus==0x80000008 && r.phyDW12==0xFFFFFFFF && r.hpd==0x01000000 && r.phyMisc==0x23000000 && r.ns==5);
+ assert(at(out,1).seq==2 && at(out,1).kind==T::BacklightWrite && at(out,2).seq==0);
+ // push() assigns the sequence; the caller's seq field is ignored.
+ e.seq=99;t.push(e);t.encode(out);assert(at(out,2).seq==3);
+ // AUX rate limit: first auxBurst admitted, then one in auxEvery, reset per training.
+ T w;uint32_t admitted=0;
+ for(uint32_t i=0;i<T::auxBurst+3*T::auxEvery;i++)admitted+=w.admitAUX();
+ assert(admitted==T::auxBurst+3);
+ w.resetAUXWindow();admitted=0;for(uint32_t i=0;i<T::auxBurst;i++)admitted+=w.admitAUX();assert(admitted==T::auxBurst);
+ // Wrap keeps the newest capacity events, oldest first.
+ for(uint32_t i=0;i<T::capacity+3;i++){e.value=i;e.ns=100+i;t.push(e);}
+ t.encode(out);memcpy(&n,out,4);assert(n==3+T::capacity+3);
+ assert(at(out,0).seq==n-T::capacity+1 && at(out,T::capacity-1).seq==n && at(out,T::capacity-1).value==T::capacity+2);
+ T copy=t;t.encode(out);assert(!memcmp(&copy,&t,sizeof(t)));
+ assert(T::regPwrAux==0x45444 && T::regPPStatus==0xC7200 && T::regPhyDW12==0x162030 && T::regHPD==0xC4000 && T::regPhyMisc==0x64C00);
+ puts("PASS: display-on trace ring, kinds, AUX rate limit, wrap, encoding");
+}
